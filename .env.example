# ── 競賽 Token Plan / QwenPaw（OpenAI 相容協議）──────────────────────
# 1) 複製本檔為 .env；2) 只在本機填 Key；3) 絕對不要提交 .env。
# sk-sp-... 是 Token Plan Key，不能配 dashscope.aliyuncs.com。
QWEN_API_KEY=

# 主辦方「Aliyun Token Plan」供應商卡片會自動選對地區。
# 網站本地接入時，請按主辦方帳戶所在地二選一；測試連接通過者為準：
# 中國區：
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 國際區（如主辦方指定新加坡區，取消下一行註釋並註釋上行）：
# QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Token Plan 精確白名單模型；qwen3.7-plus 支援推理與函數調用。
QWEN_MODEL=qwen3.7-plus

# 普通按量 DashScope Key（sk-...，非 sk-sp-...）才使用：
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# 智能體單次規劃最多迭代步數
MAX_AGENT_STEPS=12
